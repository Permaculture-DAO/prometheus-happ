# Prometheus gateway — site config template. Copy to /etc/prometheus/gateway.env
# (NOT committed; no secrets in git). See ops-docs Raspberry Pi runbook + the pilot
# SENSOR_INTEGRATION_SPEC. Until PROMETHEUS_ALLOW_REAL=1, every reading is forced to TEST.

# --- MQTT broker (Mosquitto on the gateway) ---
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=prometheus/+/+
MQTT_USERNAME=sensors
MQTT_PASSWORD=            # set a strong site password; never commit it
MQTT_RECONNECT_MS=1000

# --- Conductor connection ---
# Launcher/hc-spin: leave PROMETHEUS_ADMIN_PORT unset (env injected).
# Standalone (separate process next to a headless conductor): set the admin port.
PROMETHEUS_ADMIN_PORT=
PROMETHEUS_APP_PORT=
PROMETHEUS_APP_ID=hearth_prometheus_web
PROMETHEUS_ROLE=hearth

# --- Frozen pilot subjects + indicators ---
# Real mode fails closed unless the subject is in this explicit comma-separated allowlist.
# Fill ONLY after exact OHE/comparator ids are confirmed and the pre-registration is frozen.
PROMETHEUS_ALLOWED_SUBJECTS=
PROMETHEUS_SUBJECT_ID=ohe-sintropico-1
# PROMETHEUS_INDICATORS=soil_moisture,precipitation,...   # extend only for a controlled campaign

# --- Sensor authenticity ---
# MQTT authentication is required for field deployment. HMAC payload signing is an
# additional supported layer when the actual sensor/adapter path is configured for it.
PROMETHEUS_REQUIRE_SIGNATURE=0
PROMETHEUS_HMAC_KEY=               # shared key only when REQUIRE_SIGNATURE=1; never commit

# --- Reliability ---
PROMETHEUS_MAX_RETRIES=3

# ============================================================================
# REAL-DATA COLLECTION GATE — single switch from TEST rehearsal to real evidence.
# Keep 0 until ALL are true:
#   reviewer appointed;
#   exact OHE subjects + comparator + dates/cadence/seasons set;
#   PRE_REGISTRATION_v1_FROZEN SHA256-recorded + GPG-signed;
#   actual gateway/sensor path passed TEST-only commissioning;
#   PROMETHEUS_ALLOWED_SUBJECTS populated from the frozen design;
#   real sensor calibration/method records exist (non-TEST evidence requires SHA-256).
#
# The baseline is the FIRST real evidence after this gate opens. Reviewer batch
# attestation is required before Gate T.0 admissibility; collection != admissibility.
PROMETHEUS_ALLOW_REAL=0
# ============================================================================
